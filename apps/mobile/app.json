{
  "expo": {
    "name": "Mosaicast",
    "slug": "mosaicast",
    "icon": "./assets/icon.png",
    "scheme": "mosaicast",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Mosaicast connects your Yamaha, iPhone and Samsung TV on your local network to read playback and control music.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "io.github.desperado.mosaicast",
      "buildNumber": "20"
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET"
      ],
      "package": "io.github.desperado.mosaicast",
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "./plugins/local-network.cjs",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mosaicast to scan the pairing QR code on your TV.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e6e6527-2710-42d5-bee6-01e4dc09f1fe"
      }
    },
    "owner": "quality-max"
  }
}
