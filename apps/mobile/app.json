{
  "expo": {
    "name": "Mosaicast",
    "slug": "mosaicast",
    "scheme": "mosaicast",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Mosaicast connects to your Yamaha on your home network to read playback and control music.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "io.github.desperado.mosaicast",
      "buildNumber": "1"
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET"
      ],
      "package": "io.github.desperado.mosaicast",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "./plugins/local-network.cjs"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e6e6527-2710-42d5-bee6-01e4dc09f1fe"
      }
    },
    "owner": "quality-max"
  }
}
