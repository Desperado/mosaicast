{
  "name": "mosaicast",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "An open-source, local-first MusicCast controller for iOS and Android.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Desperado/mosaicast.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run start --workspace @mosaicast/mobile --",
    "ios": "npm run ios --workspace @mosaicast/mobile",
    "android": "npm run android --workspace @mosaicast/mobile",
    "web": "npm run web --workspace @mosaicast/mobile",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test tools/*.test.cjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "bundle:check": "npm run export:web --workspace @mosaicast/mobile",
    "bridge": "npm run build --workspace @mosaicast/musiccast && node tools/bridge.cjs"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
